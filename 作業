    "\n",
    "    # VaR：損失取正數\n",
    "    var = -(mu + sigma * z)\n",
    "\n",
    "    # ES：常態分配左尾條件期望\n",
    "    es = -mu + sigma * stats.norm.pdf(z) / alpha\n",
