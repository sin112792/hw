    "# 第三題 3-3：樣本數與檢定力分析\n",
    "# 第9組：長榮（2603.TW）\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from statsmodels.stats.power import TTestPower\n",
    "\n",
    "# 1. 取得長榮與大盤共同交易日的超額報酬\n",
    "data = pd.concat([r, m], axis=1).dropna()\n",
