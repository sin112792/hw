    "\n",
    "N = len(df5)\n",
    "k = 2  # 參數個數 (alpha, beta)\n",
    "rss_ur = rss_pre + rss_post\n",
    "\n",
    "F_chow = ((rss_full - rss_ur) / k) / (rss_ur / (N - 2 * k))\n",
    "p_chow = stats.f.sf(F_chow, k, N - 2 * k)\n",
    "\n",
    "# 2. 虛擬變數與交互作用項估計 (一般 OLS)\n",
    "df5['D'] = np.where(mask_post, 1, 0)\n",
