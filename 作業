    "\n",
    "d = data['長榮'] - data['大盤']\n",
    "\n",
    "# 2. 使用 d 的樣本平均與標準差作為真實效果\n",
    "n_current = len(d)\n",
    "mean_d = d.mean()\n",
    "std_d = d.std(ddof=1)\n",
    "\n",
    "# 效果量 Cohen's d\n",
    "effect_size = abs(mean_d / std_d)\n",
    "\n",
    "# 3. 設定顯著水準與目標檢定力\n",
    "alpha = 0.05\n",
    "target_power = 0.80\n",
    "\n",
    "power_analysis = TTestPower()\n",
    "\n",
    "# 4. 計算達到80%檢定力所需樣本數\n",
    "if effect_size > 0:\n",
    "    n_required = power_analysis.solve_power(\n",
    "        effect_size=effect_size,\n",
    "        alpha=alpha,\n",
    "        power=target_power,\n",
    "        alternative='two-sided'\n",
    "    )\n",
    "\n",
    "    # 樣本數必須向上取整\n",
    "    n_required = int(np.ceil(n_required))\n",
    "\n",
    "    # 5. 計算目前樣本數下的實際檢定力\n",
    "    current_power = power_analysis.power(\n",
    "        effect_size=effect_size,\n",
    "        nobs=n_current,\n",
    "        alpha=alpha,\n",
    "        alternative='two-sided'\n",
    "    )\n",
    "else:\n",
