    "# 第四題 4-1：不同年份的平均日報酬率比較\n",
    "# 第9組：長榮（2603.TW）\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from scipy import stats\n",
    "\n",
    "# 1. 整理長榮日對數報酬率\n",
    "資料 = pd.DataFrame({'報酬率': r.dropna()})\n",
    "資料.index = pd.to_datetime(資料.index)\n",
    "資料['年份'] = 資料.index.year\n",
