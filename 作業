    "資料 = 資料[資料['年份'].between(2019, 2025)]\n",
    "\n",
    "# 依年份分組\n",
    "groups = [\n",
    "    資料.loc[資料['年份'] == year, '報酬率'].to_numpy()\n",
    "    for year in range(2019, 2026)\n",
    "]\n",
